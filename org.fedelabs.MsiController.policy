<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD polkit Policy Configuration 1.0//EN"
"http://www.freedesktop.org/software/polkit/policyconfig-1.dtd">
<policyconfig>

  <vendor>msi-controller</vendor>
  <vendor_url>https://github.com/Fede2782/MsiController</vendor_url>

  <action id="org.fedelabs.MsiControllerAPI.write">
    <description>Edit system configuration of MSI Laptops.</description>
    <message>Authentication is required to apply a change to your system configuration.</message>
    <!-- <icon_name>msi-controller</icon_name> -->
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

</policyconfig>
