#!/bin/sh
# Debian postinst: runs after the package is installed or upgraded. (The
# RPM uses the systemd macros in postinst.rpm, prerm.rpm and postun.rpm.)
#
# Enables the backend service for every boot and (re)starts it, so the
# application works right away and an upgrade runs the new binary. Skipped
# where systemd isn't the running init (containers, chroots).
set -e

if [ -d /run/systemd/system ]; then
    systemctl daemon-reload || true
    systemctl enable org.fedelabs.eccontroller.service || true
    systemctl restart org.fedelabs.eccontroller.service || true
fi

exit 0
