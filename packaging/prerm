#!/bin/sh
# Debian prerm: runs before the package is removed or upgraded. Only a real
# removal ("remove") stops and disables the service; upgrades leave it
# running for postinst to restart.
set -e

case "$1" in
    remove)
        if [ -d /run/systemd/system ]; then
            systemctl disable --now org.fedelabs.eccontroller.service || true
        fi
        ;;
esac

exit 0
